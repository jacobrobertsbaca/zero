# Optional. Without this, `npm run dev` uses a local Supabase instance automatically.
#
# To connect to production instead, copy this file to .env.local and fill in values
# from Supabase Dashboard: https://supabase.com/dashboard/project/_/settings/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVER_KEY=your-service-role-key
